# Datos generados en tiempo de ejecución (no son código, no se versionan)
# INFORMES contiene volcados reales de equipos (nº de serie, claves de
# licencia de Windows en claro) -> nunca al historial de Git.
BACKUPS/
ARCHIVADOS/
INFORMES/
claude.backups/
__pycache__/
*.pyc
multisys.db
cagada.jpg
MULTISYS.rar

# Copias de seguridad manuales sueltas (la convención pasa a ser Git)
*.bak

# Config local de Claude Code (permisos por máquina, no compartido)
.claude/settings.local.json

# Artefactos de build (PyInstaller)
build/
dist/
*.spec.bak

# Móviles enlazados e informes (protegidos con DPAPI, pero son datos reales)
movil.db

# Icono generado por INSTALL\create_icon.py en cada build
INSTALL/masys.ico

# Servidor de RustDesk: programas compilados (compilar_servidor.bat), su código descargado y sus datos (clave privada)
SERVIDOR_RUSTDESK/bin/
SERVIDOR_RUSTDESK/fuente/
SERVIDOR_RUSTDESK/datos/
INSTALL/build_unico/

# Instrucciones internas de desarrollo (no se publican)
CLAUDE.md
